{
  "name": "@agegr/pi-web",
  "version": "0.7.17",
  "description": "Web UI for the pi coding agent",
  "homepage": "https://github.com/agegr/pi-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agegr/pi-web.git"
  },
  "bugs": {
    "url": "https://github.com/agegr/pi-web/issues"
  },
  "license": "MIT",
  "bin": {
    "pi-web": "bin/pi-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "dev": "bun run next dev -p 30141",
    "build": "bun --bun ./node_modules/next/dist/bin/next build --webpack",
    "start": "bun run next start -p 30141",
    "prepack": "node -e \"const fs=require('fs');if(!fs.existsSync('.next/BUILD_ID')){console.error('prepack: missing .next build artifacts — run npm run build first');process.exit(1)}\"",
    "lint": "eslint .",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@oh-my-pi/pi-agent-core": "17.0.7",
    "@oh-my-pi/pi-ai": "17.0.7",
    "@oh-my-pi/pi-coding-agent": "17.0.7",
    "@oh-my-pi/pi-tui": "17.0.7",
    "next": "16.2.9",
    "next-intl": "^4.13.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@lobehub/icons": "^5.6.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.14.0",
    "postcss": "^8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  }
}
